# ---- Server ----
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ur_exam
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Optional: separate HMAC key for signing verifiable credentials (falls back to JWT_SECRET)
# CREDENTIAL_SECRET=
CLIENT_ORIGIN=http://localhost:5173

# Optional: SMTP for staff OTP emails. When unset OTP codes are logged to the server console.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=noreply@example.com
# EMAIL_PASS=
# EMAIL_FROM="UR ExamLab <noreply@example.com>"

# Exam integrity: tab switches allowed before auto-submit (default 3)
# MAX_TAB_SWITCHES=3

# Optional: real UR registry API. When unset the seeded local registry is used.
# UR_REGISTRY_API=https://registry.example.ur.ac.rw/students
# UR_REGISTRY_KEY=your-institutional-api-key

# Optional: OpenAI-compatible LLM provider. When unset the built-in
# pedagogical heuristics engine is used (fully offline).
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# ---- Client ----
VITE_API_URL=/api
